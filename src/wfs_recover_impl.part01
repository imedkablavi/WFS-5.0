from dataclasses import dataclass, field, asdict
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional, Iterable

VERSION = "0.6.0"
FRAG = 2 * 1024 * 1024
MAX_PACKET = 4 * 1024 * 1024
SYNC = b"\x00\x00\x01"
VIDEO_TYPES = {0xFC, 0xFD, 0xFE}
KNOWN_TYPES = VIDEO_TYPES | {0xFA, 0xF9}
FPS_CHOICES = (15.0, 25.0)
FAT32_LIMIT = 4 * 1024**3 - 1

# Conservative default QC thresholds. They are heuristics, not universal WFS constants.
PASS_COVERAGE = 0.995
REVIEW_COVERAGE = 0.970
PASS_RATE_ERR = 0.005
FAIL_RATE_ERR = 0.020
PASS_DUR_ERR = 0.005
FAIL_DUR_ERR = 0.020
PASS_AMBIGUOUS = 0
SCENE_JUMP_REVIEW = 28
SCENE_MARGIN_STRONG = 6


class WFSParseError(Exception):
    pass


