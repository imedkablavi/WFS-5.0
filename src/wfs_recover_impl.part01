    scene_hashes: list[str]
    output: str
    sha256: str
    strategy: str


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def decode_ts(v: int) -> Optional[datetime]:
    try:
        return datetime(
            2000 + ((v >> 26) & 0x3F),
            (v >> 22) & 0x0F,
            (v >> 17) & 0x1F,
            (v >> 12) & 0x1F,
            (v >> 6) & 0x3F,
            v & 0x3F,
        )
    except ValueError:
        return None


def packet_info(b: bytes, p: int = 0):
    remain = len(b) - p
    if remain < 4:
        return "short", None, None, None, None
    if b[p:p + 3] != SYNC:
        return "bad", None, None, None, None

    typ = b[p + 3]
    if typ in (0xFD, 0xFE):
        hdr = 16
        if remain < hdr:
            return "short", typ, hdr, None, None
        size = struct.unpack_from("<I", b, p + 12)[0]
    elif typ == 0xFC:
        hdr = 8
        if remain < hdr:
            return "short", typ, hdr, None, None
        size = struct.unpack_from("<I", b, p + 4)[0]
    elif typ in (0xFA, 0xF9):
        hdr = 8
        if remain < hdr:
            return "short", typ, hdr, None, None
        size = struct.unpack_from("<H", b, p + 6)[0]
    else:
        return "bad", typ, None, None, None

    if not 0 < size <= MAX_PACKET:
        return "bad", typ, hdr, size, None

    return "ok", typ, hdr, size, hdr + size


def padding_here(b: bytes, p: int, run: int = 64) -> bool:
    """
    Padding is only tested at a record boundary.
    A four-byte run is deliberately NOT enough evidence.
    """
    remain = len(b) - p
    if remain <= 0:
        return True
    n = min(run, remain)
    if n < 16:
        return all(x in (0x00, 0xFF) for x in b[p:])
    return all(x in (0x00, 0xFF) for x in b[p:p + n])


def parse_tail(b: bytes) -> Optional[bytes]:
    """
    Returns:
      None  -> terminal padding reached
      b""   -> exact record boundary at end of fragment
      bytes -> incomplete record requiring continuation
    """
    p = 0
    while p < len(b):
        if padding_here(b, p):
            return None

        status, typ, hdr, size, total = packet_info(b, p)
        if status == "short":
            return b[p:]
        if status == "bad":
            raise WFSParseError(
                f"sync lost at 0x{p:X}: {b[p:p+32].hex(' ')}"
            )
        if p + total > len(b):
            return b[p:]
        p += total
    return b""


def source_guard(raw: Path, allow_device: bool = False) -> dict:
    """
    Verify source is suitable for read-only analysis.
    For a block device we insist it is read-only unless --allow-device is given.
    """
    info = {"source": str(raw), "kind": "file"}
    if not raw.exists():
        raise SystemExit(f"Source does not exist: {raw}")

    st = raw.stat()
    info["size"] = st.st_size

    if raw.is_block_device():
        info["kind"] = "block-device"
        # stat().st_size is commonly zero for Linux block devices.
        try:
            p = subprocess.run(
                ["blockdev", "--getsize64", str(raw)],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=30,
            )
            if p.returncode == 0:
                info["size"] = int(p.stdout.decode().strip())
        except Exception:
            pass
        if not info["size"]:
            raise SystemExit(f"Unable to determine block-device size: {raw}")
        dev = raw.name
        ro_path = Path("/sys/class/block") / dev / "ro"
        ro = None
        if ro_path.exists():
            try:
                ro = ro_path.read_text().strip()
            except Exception:
                pass
        info["sysfs_ro"] = ro
        if ro != "1" and not allow_device:
            raise SystemExit(
                f"REFUSING: {raw} is not confirmed read-only. "
                "Use a forensic image/RAW or make the device read-only first."
            )
    return info


def sha256_file(path: Path, block: int = 8 * 1024 * 1024) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(block), b""):
            h.update(chunk)
    return h.hexdigest()


