#!/usr/bin/env python3
"""
WFS 0.5 DVR/NVR recovery toolkit for forensic and data-recovery workflows.

IMPORTANT
---------
This tool is intentionally conservative. It never writes to the source RAW/device,
does not mount/repair WFS, and does not claim physical camera identity unless the
operator explicitly supplies anchors.

The default recovery profile currently understands the following observed WFS 0.5 framing:
  * 2 MiB WFS data fragments
  * proprietary record sync 00 00 01
  * record types FD/FE/FC carrying HEVC payloads
  * FA/F9 non-video wrappers
  * WFS-style timestamp in FD/FE records

This is NOT a generic WFS 0.5 implementation for every DVR vendor.

Typical workflow:
  python3 wfs_recover.py scan ...
  python3 wfs_recover.py recover --segments 09-00,10-00,11-00,13-00,14-00,22-00,23-00 ...
  python3 wfs_recover.py recover --resume ...
  python3 wfs_recover.py report ...
"""

from __future__ import annotations

import argparse
import csv
import hashlib
import html
import itertools
import json
import math
